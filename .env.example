# Chief of Staff (Jarvis) — configuration
# Copy to your shell env or a launcher; all are optional with sensible defaults.

# Where the file-bridge lives (request/response/outputs folders).
# Default: ~/Documents/CoS-Bridge
COS_BRIDGE_ROOT=

# Voice used by macOS `say` for spoken replies. Download premium voices in
# System Settings > Accessibility > Spoken Content. Default: "Ava (Premium)"
COS_SAY_VOICE=Ava (Premium)

# Path to the Kiro CLI binary. Default: ~/.local/bin/kiro-cli
KIRO_CLI=

# Working directory the AI Developer (Kiro CLI) runs in. This is the ONLY
# folder the agent should operate in — keep it a dedicated project directory,
# NOT your home folder (from ~ the agent could crawl OneDrive/iCloud/Documents).
# Default: ~/Documents/CoS-Projects (created on demand).
KIRO_CWD=

# Which tools the AI Developer (Kiro CLI) is allowed to use. Safe default trusts
# ONLY file read/write, so it can build files in KIRO_CWD but cannot run shell
# commands, call AWS, or use other tools. Untrusted tools are blocked in
# non-interactive mode. Default (unset): fs_read,fs_write
#   ""    = trust nothing
#   all   = trust every tool (NOT recommended)
#   fs_read,fs_write,execute_bash = custom allow-list
KIRO_TRUST_TOOLS=

# Path to the Open Design `od` CLI (optional). Open Design ships WITH this app
# as a git submodule at third_party/open-design; the app resolves the bundled
# `od` automatically after you run ./scripts/setup-open-design.sh. Only set this
# to point at a different Open Design install.
OD_BIN=

# Open Design daemon URL override (optional). Default probes 7456 / 57776.
OD_DAEMON_URL=
